// Osysharp.S3 — an `app.BlobStore` for S3-compatible object storage (AWS S3, Cloudflare R2), written in Osy#.
//
// It needs nothing privileged. It is ordinary Osy# using only public APIs — a class implementing the Storage package's
// `IBlobStore`, signing its own requests with `Crypto.*` and sending them with `Http.*` — so anyone could have written
// it exactly as it is.
//
// It asks for two hosts and two secrets, and an app that uses it grants them or does not compile.
package Osysharp.S3 {
  version     "1.1.0";
  minPlatform "0.14.0";
  summary     "an app.BlobStore for S3-compatible object storage — AWS S3 and Cloudflare R2 — signed with SigV4.";

  model "model/*.osy";
  use Osysharp.Http;
  use Osysharp.Storage;

  egress "*.amazonaws.com";
  egress "*.r2.cloudflarestorage.com";
  secret "S3AccessKeyId";
  secret "S3SecretAccessKey";
}
